# Private collections are served only through ../private-favs.php after the password is entered.
<FilesMatch "^Private.*\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
