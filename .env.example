# Optional: YouTube Data API v3 key for player UI extras.
# Enables:
#   - current video upload date under Mode
#   - real titles in the playlist list (click N / total next to Mode)
# Without this key (or if the key is invalid), the app still works:
#   upload date stays hidden, and the playlist list uses "Video N" placeholders.
# Copy to .env and set your key.
YOUTUBE_API_KEY=

# Password for private collections (favs/Private*.json). Checked only on the server.
# Store a bcrypt hash, never the plain password. Generate one with:
#   php -r 'echo password_hash("your password", PASSWORD_DEFAULT), PHP_EOL;'
# Paste it in single quotes so the $ signs stay intact, e.g.
#   PRIVATE_PLAYLISTS_PASSWORD_HASH='$2y$10$replace.with.your.own.hash'
PRIVATE_PLAYLISTS_PASSWORD_HASH=
